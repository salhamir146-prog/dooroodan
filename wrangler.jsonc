{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dooroodan",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dooroodan-db",
      "database_id": "1f32c0c0-8b1c-43ba-8dd1-e4a55e2156d5"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "PASTE_YOUR_KV_ID_HERE"
    }
  ]
}
